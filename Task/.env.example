# Google Gemini API key (https://aistudio.google.com/apikey) — used for speech-to-text, extraction and Q&A
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# SQLite by default; any SQLAlchemy URL works (postgres:// URLs are auto-converted to psycopg)
DATABASE_URL=sqlite:///./data/meetings.db

# Where uploaded audio is staged while it is processed (deleted afterwards)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100
MAX_TRANSCRIPT_CHARS=300000

# Comma-separated origins allowed to call the API from another domain (empty = same-origin only)
CORS_ORIGINS=

# run.py only
HOST=127.0.0.1
PORT=8000
RELOAD=false
