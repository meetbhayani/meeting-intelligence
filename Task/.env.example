# Google Gemini API key (https://aistudio.google.com/apikey) — used for speech-to-text, extraction and Q&A
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIPTION_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# Analysis fallback when the selected model is overloaded (503) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# SQLite by default; any SQLAlchemy URL works (postgres:// URLs are auto-converted to psycopg)
DATABASE_URL=sqlite:///./data/meetings.db
